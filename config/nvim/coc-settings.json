{
  "languageserver": {
    "terraform": {
      "command": "terraform-ls",
      "args": ["serve"],
      "filetypes": ["terraform", "tf"],
      "initializationOptions": {}
    }
  },
  "diagnostic-languageserver.formatFiletypes": {
    "sh": "shfmt",
    "bash": "shfmt",
    "zsh": "shfmt"
  },
  "diagnostic-languageserver.formatters": {
    "shfmt": {
      "command": "/opt/homebrew/bin/shfmt",
      "args": [
        "--indent",
        "0",
        "--binary-next-line",
        "--case-indent",
        "--space-redirects",
        "--simplify"
      ]
    }
  },
  "diagnostic.errorSign": "✖",
  "diagnostic.warningSign": "⚑",
  "diagnostic.infoSign": "⚑",
  "diagnostic.hintSign": "⚑",
  "suggest.virtualText": true,
  "diagnostic.virtualText": false,
  "diagnostic.virtualTextCurrentLineOnly": false,
  "coc.preferences.formatOnSaveFiletypes": [
    "bash",
    "css",
    "go",
    "haskell",
    "html",
    "java",
    "javascript.jsx",
    "javascript",
    "js",
    "json",
    "kotlin",
    "python",
    "rust",
    "sh",
    "sql",
    "svelte",
    "terraform",
    "typescript.tsx",
    "typescript",
    "typescriptreact",
    "yaml",
    "zig",
    "zsh"
  ],
  "tsserver.formatOnType": false,
  "rust-analyzer.cargo.cfgs": [],
  "sql.formatOptions": {
    "language": "mysql"
  },
  "svelte.enable-ts-plugin": true,
  "zig.path": "/opt/homebrew/bin/zls",
  "java.import.gradle.java.home": "/Library/Java/JavaVirtualMachines/amazon-corretto-17.jdk/Contents/Home"
}
